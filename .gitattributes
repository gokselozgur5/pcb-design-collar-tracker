# Preserve exact CAD, manufacturing and evidence bytes across checkouts.
* -text
*.md text eol=lf
*.py text eol=lf
*.cjs text eol=lf
*.pdf binary
*.png binary
*.jpg binary
*.zip binary
*.stl binary
# Keep the exact uploaded CSV bytes; CRLF is the CSV writer's record separator.
/assembly/pcba-r03/*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve the downloaded rule snapshot and its original, verified hash.
/assembly/pcba-r03/jlc-rules.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Exact inputs of the rejected datum diagnostic, not order files.
/assembly/pcba-r04/*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve the original failing OpenSCAD stderr, including its final empty line.
/mechanical/universal-mount-r01/evidence/initial-flat-pad/export.log whitespace=-blank-at-eof
# Vendored renderer bytes are pinned; GLSL strings retain upstream whitespace.
/mechanical/universal-mount-r01/viewer-assets/three.bundle.mjs linguist-vendored whitespace=-blank-at-eol
# GitHub Linguist overrides
*.kicad_pcb linguist-language=KiCad-Layout
*.kicad_sch linguist-language=KiCad-Schematic
hardware/*.kicad_pcb linguist-detectable=true
hardware/*.kicad_sch linguist-detectable=true
experiments/paul-nanosim-r04c/hardware/*.kicad_pcb linguist-detectable=true
experiments/paul-nanosim-r04c/hardware/*.kicad_sch linguist-detectable=true
*.kicad_mod linguist-vendored=true
*.kicad_sym linguist-vendored=true
**/gerbers/** linguist-generated=true
build/** linguist-generated=true
experiments/**/build/** linguist-generated=true
snapshots/** linguist-generated=true
mechanical/universal-mount-r01/viewer.html linguist-documentation=false linguist-vendored=true
mechanical/universal-mount-r01/viewer-assets/viewer.template.html linguist-documentation=false linguist-vendored=true
