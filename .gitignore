!/references/paul-nanosim-r04/SIM8051-drawing-D5.pdf
!/references/paul-nanosim-r04/SIM8051-land-detail.png
!/references/paul-nanosim-r04/TPD4E1U06.pdf
!/references/paul-nanosim-r04/SIM8051-drawing-D6.pdf
