.DS_Store
._*
*-backups/
*.kicad_prl
*.lck
__pycache__/
*.py[cod]
*.log
.venv*/
node_modules/
.router-home/
.router-audit/
.runtime/
CLAUDE.local.md
.env
.env.*
!.env.example
*.pem
*.key

# Routing scratch inputs/backups are local; saved native projects are authoritative.
/experiments/power-r05g-local-crossings/build/*
!/experiments/power-r05g-local-crossings/build/placement.json
/experiments/power-r05h-six-layer/build/*
!/experiments/power-r05h-six-layer/build/placement.json
/experiments/power-r05l-charge-interlock/build/*
!/experiments/power-r05l-charge-interlock/build/placement.json
**/browser-profile/
**/browser-tmp/
**/st-browser/
**/storage-state*.json
**/page.html
**/*.meta.json
**/*.bin

# Raw browser captures stay local. Only reviewed evidence is published.
/evidence/*
!/evidence/order-readiness-20261025-r034/
!/evidence/release-034/
!/evidence/power-review-r04i/
/evidence/power-review-r04i/*.xml
/evidence/order-readiness-20261025-r034/*.log

# Downloaded third-party repositories, archives and unrelated research stay local.
/references/*
!/references/manifest.json
!/references/assembly-review-20261024/
!/references/paul-nanosim-r04/
/references/paul-nanosim-r04/*
