(wire (pts (xy 190.5000 350.5200) (xy 190.5000 355.6000)) (stroke (width 0) (type default)) (uuid 2336e16b-59af-5607-8735-d11f033f9ba1))
(label "GND" (at 190.5000 355.6000 0) (effects (font (size 0.9 0.9)) (justify left bottom)) (uuid d211f21a-228a-5060-b7ba-2dbd6d90ce8a))
      (text "01 / MODEM, GNSS AND APPLICATION MCU" (at 65 22 0) (effects (font (size 2 2)) (justify left top)) (uuid 331cd9c4-4756-5a63-95ec-f8532adfce40))(text "Reserved pins 31-33 and 81-104: electrically unconnected.\nSIM_DET is not supported. No external pull-up on nRESET." (at 65 163 0) (effects (font (size 1.25 1.25)) (justify left top)) (uuid beb0ad71-b7eb-5d4c-90f7-6f4738058e7e))(text "REFERENCE DECOUPLING / NOT A COMPLETE RF LAYOUT" (at 225 22 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid bc905767-5ee0-51ff-a93a-1ae6be86aeb2))(text "02 / LTE AND GNSS FRONT END" (at 390 22 0) (effects (font (size 2 2)) (justify left top)) (uuid 21309581-8b4a-5035-ad05-9f3dfa24074d))(text "GPS and cellular do not receive/transmit concurrently.\nGNSS RF ESD, matching and body/enclosure tuning remain open.\nNo NTN/B255 requirement in this draft." (at 390 189 0) (effects (font (size 1.25 1.25)) (justify left top)) (uuid e55b07c5-032f-5d5b-9968-993be5a56889))(text "03 / POWER — FIRST CIRCUIT DRAFT" (at 25 209 0) (effects (font (size 2 2)) (justify left top)) (uuid 04f51a3d-d6fd-5dfa-b5f9-7069791b49bc))(text "HOLD: add/verify hardware undervoltage cutoff (VDD >=3.0V),\nVDD_GPIO startup/shutdown sequencing, charging-input protection,\nand battery/NTC ratings before layout release.\nBQ25185 internal battery cutoff alone is insufficient for nRF9151.\nBAT_ADC: allow divider/filter settling; do not sample immediately." (at 25 382 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid 4520c417-0208-5c0b-b079-4372efcf8e3c))(text "04 / MOTION AND HEART-RATE EXPANSION" (at 255 209 0) (effects (font (size 2 2)) (justify left top)) (uuid 154af706-c065-5e4c-b5b7-ef1b29c617f2))(text "Digital interface only — not an electrode connection.\nPPG/ECG measurement head, power switching and protection\nmust be designed and validated separately.\nNo heart-rate sensor selected; no heart-rate accuracy claim." (at 255 341 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid 3f8cfd52-c0f8-53ca-895b-c794f7745550))(text "05 / eSIM AND DEBUG INTERFACES" (at 465 209 0) (effects (font (size 2 2)) (justify left top)) (uuid 58fd52e6-aefc-5349-86cd-20825e03cfa2))(text "J6 is NOT a purchasable eSIM or its footprint.\nSelect 1.8V eUICC + carrier profile, then map\nthese signals to its actual package pins.\nSIM_1V8 must remain separate from VIO_1V8." (at 465 273 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid aea9c6e3-e09a-5f9c-84ef-7caaaf102ac8))(text "Reset has an internal 2.2V pull-up.\nDebug reset driver: open drain, compatible voltage.\nNo external reset pull-up." (at 465 349 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid 655c33e5-2ec0-5a1b-b8bc-64ca3c7bf205))(text "DFM REVIEW DRAFT 0.2 — NOT RELEASED FOR ORDER\nTurkey / shared lightweight body / heart-rate feasibility pending" (at 255 382 0) (effects (font (size 1.7 1.7)) (justify left top)) (uuid 42e9da3b-db2f-5643-98a8-3abfcd730926))
      (sheet_instances (path "/" (page "1"))))